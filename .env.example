# Local development defaults. Copy this file to .env and change the passwords
# and JWT_SECRET before using the app with any real data.
# If a password contains characters such as @ : / #, URL-encode it inside the URLs below.
# POSTGRES_PASSWORD, the password in DATABASE_ADMIN_URL, DB_APP_PASSWORD, and the
# password in DATABASE_URL must match each other.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 5433 avoids a local PostgreSQL install that is already bound to 5432.
POSTGRES_PORT=5433

DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5433/postgres
DATABASE_URL=postgresql+psycopg://expense_app:change-me-app-password@localhost:5433/expense_tracker

DB_NAME=expense_tracker
DB_APP_USER=expense_app
DB_APP_PASSWORD=change-me-app-password

JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRE_MINUTES=60

APP_USERNAME=admin
APP_PASSWORD=change-me-user-password

API_BASE_URL=http://127.0.0.1:8000
